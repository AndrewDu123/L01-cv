    "print(\"y_train:\", y_train.shape)\n",
    "print(\"y_test:\", y_test.shape)\n",
    "\n",
    "\n",
    "# Q3: Load, reshape, and normalize the dataset\n",
    "import pickle\n",
    "import numpy as np\n",
    "\n",
    "with open('data/minst.pkl', 'rb') as f:\n",
    "    data = pickle.load(f)\n",
    "X_train, y_train = data['X_train'], data['y_train']\n",
    "X_test, y_test = data['X_test'], data['y_test']\n",
    "\n",
    "# Use dynamic shape inference (-1) and normalize pixel values to [0, 1]\n",
    "X_train_flat = X_train.reshape(X_train.shape[0], -1) / 255.0\n",
    "X_test_flat = X_test.reshape(X_test.shape[0], -1) / 255.0\n",
    "\n",
    "print(\"Q3: Reshaped and Normalized Data\")\n",
    "print(\"Training shape:\", X_train_flat.shape)\n",
    "print(\"Testing shape:\", X_test_flat.shape)\n",
    "\n",
    "assert X_train_flat.shape[1] == 784\n",
    "assert X_test_flat.shape[1] == 784\n",
    "assert X_train_flat.shape[0] == len(y_train)\n",
    "assert X_test_flat.shape[0] == len(y_test)\n",
    "print(\"All checks passed.\")\n",
    "\n",
    "\n",
    "\n",
    "[ ]\n",
    "# Question 4: Build k-NN classifier, evaluate odd values of k, and save the best model\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.metrics import accuracy_score\n",
    "import numpy as np\n",
    "\n",
    "print(\"Building k-NN Classifier and tuning k\\n\")\n",
    "evals_ks = np.array([1, 3, 5, 7, 9])\n",
    "eval_valid_accuracy = []\n",
    "best_model = None\n",
    "highest_accuracy = -1\n",
    "\n",
    "for eval_k in evals_ks:\n",
    "    candidate = KNeighborsClassifier(n_neighbors=int(eval_k))\n",
    "    candidate.fit(X_train_flat, y_train)\n",
    "    preds = candidate.predict(X_test_flat)\n",
    "    acc = accuracy_score(y_test, preds)\n",
    "    eval_valid_accuracy.append(acc)\n",
    "    print(f\"k = {eval_k} accuracy = {acc:.4f}\")\n",
    "\n",
    "    # Save the model with the highest accuracy\n",
    "    if acc > highest_accuracy:\n",
    "        highest_accuracy = acc\n",
    "        best_model = candidate\n",
    "        eval_k_star = eval_k\n",
    "\n",
    "print(f\"\\nOptimal k value: {eval_k_star}\")\n",
    "\n",
    "[ ]\n",
    "# Question 5: Compute confusion matrix and evaluate performance using the saved best model\n",
    "from sklearn.metrics import confusion_matrix, accuracy_score, ConfusionMatrixDisplay\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Reuse the optimal model instance saved during Q4\n",
    "y_valid_predict = best_model.predict(X_test_flat)\n",
    "\n",
    "print(\"Confusion Matrix:\\n\")\n",
    "cm = confusion_matrix(y_test, y_valid_predict)\n",
    "print(cm)\n",
    "\n",
    "accuracy = accuracy_score(y_test, y_valid_predict)\n",
    "print(f\"\\nAccuracy: {accuracy:.4f}\")\n",
    "\n",
    "# Optional graphical confusion matrix display\n",
    "disp = ConfusionMatrixDisplay(confusion_matrix=cm)\n",
    "disp.plot(cmap=plt.cm.Blues)\n",
    "plt.title(f\"Confusion Matrix for optimal k = {eval_k_star}\")\n",
    "plt.show()"

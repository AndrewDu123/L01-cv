     "text": [
      "Building k-NN Classifier\n",
      "\n",
      "k = 1 accuracy = 0.9691\n",
      "k = 3 accuracy = 0.9705\n",
      "k = 5 accuracy = 0.9688\n",
      "k = 7 accuracy = 0.9694\n",
      "k = 9 accuracy = 0.9659\n",
      "\n",
      "highest k value:  3\n"
     ]
    }
   ],
   "source": [
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.metrics import accuracy_score, confusion_matrix\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "\n",
    "print(\"Building k-NN Classifier\\n\")\n",
    "evals_ks = np.array([1, 3, 5, 7, 9])\n",
    "eval_valid_accuracy = []\n",
    "\n",
    "# iterate through each K\n",
    "for eval_k in evals_ks:\n",
    "    eval_candidate = KNeighborsClassifier(n_neighbors=int(eval_k))\n",
    "    eval_candidate.fit(X_train_flat, y_train)\n",
    "    eval_valid_hat = eval_candidate.predict(X_test_flat)\n",
    "    eval_valid_accuracy.append(\n",
    "        accuracy_score(y_test, eval_valid_hat)\n",
    "    )\n",
    "    print(\"k =\", eval_k, \"accuracy =\", accuracy_score(y_test, eval_valid_hat))\n",
    "\n",
    "eval_k_star = int(evals_ks[np.argmax(eval_valid_accuracy)])\n",
    "print(\"\\nhighest k value: \", eval_k_star)"
   ]
  },

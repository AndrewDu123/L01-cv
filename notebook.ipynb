      "source": [
        "# Your Phase 1 solution to the problem goes here.\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "from sklearn.metrics import accuracy_score\n",
        "from sklearn.metrics import confusion_matrix\n",
        "import numpy as np\n",
        "\n",
        "\n",
        "import pickle\n",
        "with open('data/minst.pkl', 'rb') as f:\n",
        "    data = pickle.load(f)\n",
        "X_train, y_train = data['X_train'], data['y_train']\n",
        "X_test, y_test = data['X_test'], data['y_test']\n",
        "# reshaping\n",
        "# Q3: Reshape 28x28 images into vectors of 784 features\n",
        "\n",
        "X_train_flat = X_train.reshape(X_train.shape[0], 784)\n",
        "X_test_flat = X_test.reshape(X_test.shape[0], 784)\n",
        "\n",
        "print(\"Q3: Reshaped data\")\n",
        "print(\"Training:\", X_train_flat.shape)\n",
        "print(\"Testing:\", X_test_flat.shape)\n",
        "\n",
        "assert X_train_flat.shape[1] == 784\n",
        "assert X_test_flat.shape[1] == 784\n",
        "assert X_train_flat.shape[0] == len(y_train)\n",
        "assert X_test_flat.shape[0] == len(y_test)\n",
        "\n",
        "print(\"All checks passed.\")\n",
        "\n",
        "\n",
        "\n",
        "# q4 creating knn from reshaped data\n",
        "\n",
        "print(\"Building k-NN Classifier\\n\")\n",
        "evals_ks = np.array([1, 3, 5, 7, 9])\n",
        "eval_valid_accuracy = []\n",
        "\n",
        "# iterate through each K\n",
        "for eval_k in evals_ks:\n",
        "    eval_candidate = KNeighborsClassifier(n_neighbors=int(eval_k))\n",
        "    eval_candidate.fit(X_train_flat, y_train)\n",
        "    eval_valid_hat = eval_candidate.predict(X_test_flat)\n",
        "    eval_valid_accuracy.append(\n",
        "        accuracy_score(y_test, eval_valid_hat)\n",
        "    )\n",
        "    print(\"k =\", eval_k, \"accuracy =\", accuracy_score(y_test, eval_valid_hat))\n",
        "\n",
        "eval_k_star = int(evals_ks[np.argmax(eval_valid_accuracy)])\n",
        "print(\"\\nhighest k value: \", eval_k_star)"
      ]
    },

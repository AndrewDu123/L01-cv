        "\n",
        "# Q5.  computing confusion matrix\n",
        "\n",
        "# train classification model with optimal k\n",
        "classification_model = KNeighborsClassifier(n_neighbors=eval_k_star).fit(\n",
        "    X_train_flat, y_train\n",
        ")\n",
        "\n",
        "y_valid_predict = classification_model.predict(X_test_flat)\n",
        "\n",
        "# confusion matrix\n",
        "print(\"confusion matrix\\n\")\n",
        "cm = confusion_matrix(y_test, y_valid_predict)\n",
        "print(cm)\n",
        "\n",
        "# check accuracy\n",
        "accuracy = accuracy_score(y_test, y_valid_predict)\n",

   "source": [
    "# Q1: Load and visualize the MNIST dataset\n",
    "\n",
    "import pickle\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "with open(\"data/minst.pkl\", \"rb\") as f:\n",
    "    data = pickle.load(f)\n",
    "\n",
    "X_train, y_train = data[\"X_train\"], data[\"y_train\"]\n",
    "X_test, y_test = data[\"X_test\"], data[\"y_test\"]\n",
    "\n",
    "print(\"Q1: Visualizing the first five digits\")\n",
    "\n",
    "for i in range(5):\n",
    "    print(f\"Image {i + 1}, label: {y_test[i]}\")\n",
    "    plt.figure(figsize=(4, 4))\n",
    "    plt.contourf(np.rot90(X_test[i].transpose()))\n",
    "    plt.title(f\"Digit: {y_test[i]}\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "# Q2: Examine dataset shapes\n",
    "\n",
    "print(\"\\nQ2: Dataset shapes\")\n",
    "print(\"X_train:\", X_train.shape)\n",
    "print(\"X_test:\", X_test.shape)\n",
    "print(\"X_train[0]:\", X_train[0].shape)\n",
    "print(\"X_test[0]:\", X_test[0].shape)\n",
    "print(\"y_train:\", y_train.shape)\n",
    "print(\"y_test:\", y_test.shape)"
   ]

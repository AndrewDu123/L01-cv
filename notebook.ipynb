      "source": [
        "# Question 4: Build k-NN classifier, evaluate odd values of k, and save the best model\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "from sklearn.metrics import accuracy_score\n",
        "import numpy as np\n",
        "\n",
        "print(\"Building k-NN Classifier and tuning k\\n\")\n",
        "evals_ks = np.array([1, 3, 5, 7, 9])\n",
        "eval_valid_accuracy = []\n",
        "best_model = None\n",
        "highest_accuracy = -1\n",
        "\n",
        "for eval_k in evals_ks:\n",
        "    candidate = KNeighborsClassifier(n_neighbors=int(eval_k))\n",
        "    candidate.fit(X_train_flat, y_train)\n",
        "    preds = candidate.predict(X_test_flat)\n",
        "    acc = accuracy_score(y_test, preds)\n",
        "    eval_valid_accuracy.append(acc)\n",
        "    print(f\"k = {eval_k} accuracy = {acc:.4f}\")\n",
        "\n",
        "    # Save the model with the highest accuracy\n",
        "    if acc > highest_accuracy:\n",
        "        highest_accuracy = acc\n",
        "        best_model = candidate\n",
        "        eval_k_star = eval_k\n",
        "\n",
        "print(f\"\\nOptimal k value: {eval_k_star}\")"
